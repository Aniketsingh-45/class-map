# Copy to .env and fill in. NEVER commit .env
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
CLAUDE_TEXT_MODEL=claude-haiku-5-5
CLAUDE_VISION_MODEL=claude-sonnet-5-5

# Backend settings
STT_PROVIDER=sarvam      # mock = fake transcript for development; sarvam = real speech-to-text
USE_CLAUDE=1               # 1 = add Claude's error-pattern summary (costs credits)
SECRET_KEY=change-me-to-a-long-random-string
DB_PATH=                   # empty = classmap.db in the project folder
AUTO_SEED=1                # 1 = create demo data on first start (synthetic only)
DEMO_PIN=1234              # PIN for demo accounts (change before sharing publicly)
CORS_ORIGINS=*             # in production: your frontend URL
MAX_AUDIO_BYTES=2000000
MAX_PHOTO_BYTES=5000000

# Claude daily token budget (safety net to control costs)
CLAUDE_DAILY_INPUT_LIMIT=50000
CLAUDE_DAILY_OUTPUT_LIMIT=10000
